---
import Layout from '../layouts/Layout.astro';
import PasswordGenerator from '../components/PasswordGenerator';
---

<Layout title="强密码生成器 - 安全、离线的在线密码生成工具">
	<main class="min-h-screen bg-slate-50 dark:bg-slate-900 py-12 px-4 sm:px-6 lg:px-8">
		<div class="max-w-3xl mx-auto space-y-8">
			<div class="text-center space-y-3">
				<h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
					强密码生成器
				</h1>
				<p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-xl mx-auto">
					即时生成高强度安全密码。所有计算均在本地浏览器中完成，绝不向网络传输任何数据。
				</p>
			</div>

			<PasswordGenerator client:load />
		</div>
	</main>
</Layout>
